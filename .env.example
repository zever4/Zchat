# Copy to .env, then generate separate random secrets (openssl rand -hex 32).
# Never commit a populated .env or print docker compose config with real secrets.
DB_USER=postgres
DB_NAME=zchat_db
DB_PASS=
JWT_SECRET=

# Optional local host ports; all are bound to 127.0.0.1.
NGINX_PORT=18080
SERVER_HTTP_PORT=18081
SERVER_GRPC_PORT=50052
DB_HOST_PORT=5433
REDIS_HOST_PORT=6379
# Redis is optional: docker compose --profile redis up -d --wait.
# Optional E2EE hints only; empty means local hints + durable polling, no Redis.
# With Compose and experimental E2EE enabled: E2EE_REDIS_ADDR=redis:6379.
E2EE_REDIS_ADDR=

# Shared upload storage budget; decimal GB (1 GB = 1,000,000,000 bytes).
# Generous friend-group defaults; actual free disk/inodes are checked as well.
# Lowering a limit preserves existing files and refuses further uploads above it.
STORAGE_TOTAL_GB=50
STORAGE_ACCOUNT_GB=10
STORAGE_FREE_GB=1
STORAGE_TOTAL_FILES=200000
STORAGE_ACCOUNT_FILES=50000
STORAGE_FREE_INODES=1024
STORAGE_UPLOADS=8
STORAGE_ACCOUNT_UPLOADS=2
STORAGE_DOWNLOADS=64
STORAGE_ACCOUNT_DOWNLOADS=16

# Only needed with compose.calls.yaml. Use distinct credentials, not JWT_SECRET.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Browser URL must enter the Go gateway. Compose sets the private SFU URL itself.
LIVEKIT_URL=ws://localhost:18080/rtc/
# Loopback demo works in Chrome. Firefox needs a reachable non-loopback IPv4;
# see development.md. MEDIA_BIND_IP changes which host interface exposes ICE.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_MEDIA_BIND_IP=127.0.0.1

# Only needed with compose.monitoring.yaml; no shared/default password.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Opt-in E2EE registry/v2 core API; desktop messaging readiness remains false. Configure TLS before remote use.
ENABLE_EXPERIMENTAL_E2EE=false

# Opt-in private storage maintenance; PUT and attachment Send also need ENABLE_EXPERIMENTAL_E2EE=true.
# Once initialized, keep this true for accounting/GC. Disable only the API above.
# Send3 requires the ready owned runtime; desktop UI/readiness remain unavailable.
# Existing owned Linux directory outside web.
# Compose prepares this private volume as UID10001/mode0700; host runs need mkdir -m700.
ENABLE_EXPERIMENTAL_E2EE_BLOBS=false
E2EE_BLOB_ROOT=/var/lib/zchat/e2ee-blobs
# Persisted PG metadata quotas: immutable after first initialization; never reset usage.
# These are independent of mutable STORAGE_* physical caps; decimal GB.
E2EE_BLOB_TOTAL_GB=50
E2EE_BLOB_ACCOUNT_GB=10
E2EE_BLOB_TOTAL_CLAIMS=50000
E2EE_BLOB_ACCOUNT_CLAIMS=25000
E2EE_BLOB_TOTAL_ATTEMPTS=100000
E2EE_BLOB_ACCOUNT_ATTEMPTS=50000
# Artifact ceiling includes in-flight publication names, matching bounded restart census.
E2EE_BLOB_MAX_ARTIFACTS=20000
E2EE_BLOB_STARTUP_VERIFY_GB=100
E2EE_BLOB_STARTUP_SECONDS=60
SERVER_HEALTH_START_PERIOD=90s
