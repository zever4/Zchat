{
  "uid": "zchat-calls",
  "title": "Zchat · Calls and LiveKit",
  "description": "Signaling is not media. k6 chat tests do not exercise WebRTC. Verify physical microphone/screen sharing separately. Calls enabled=0 with LiveKit target DOWN is expected when optional calls are disabled. Management metrics record retry failures even if clients look connected.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "zchat"
  ],
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Calls configured",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "zchat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zchat_calls_enabled{job=\"zchat-backend\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "zchat-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
