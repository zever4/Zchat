{
  "uid": "zchat-load",
  "title": "Zchat \u00b7 Load test and resource limits",
  "description": "Lab only: make load-run exports k6 metrics and samples Docker stats without giving containers a Docker socket. Select the time interval of one run. k6 percentiles are per generator/VU-group snapshots; do not sum percentiles. Finished runs become stale; historical graphs remain. CPU cores, RAM and sampler freshness must be considered before attributing a bottleneck to the app.",
  "schemaVersion": 39,
  "version": 3,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "zchat"
  ],
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "k6 active / allocated VUs",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "zchat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_vus",
          "legendFormat": "active VUs",
          "datasource": {
            "type": "prometheus",
            "uid": "zchat-prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "k6_vus_max",
          "legendFormat": "allocated VUs",
          "datasource": {
            "type": "prometheus",
            "uid": "zchat-prometheus"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
